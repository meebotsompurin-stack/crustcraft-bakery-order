# ==============================================================================
# CrustCraft Artisan Bakery - Root Environment Configuration Example
# Copy this file to .env and adjust values for local development.
# ==============================================================================

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://crustcraft:crustcraft_password@localhost:5432/crustcraft?schema=public"

# Authentication & Security
JWT_SECRET="crustcraft-dev-jwt-secret-replace-in-production-2026"

# Server Network Configuration (Cloud Run defaults to PORT=3000 / $PORT)
# PORT=3000
PORT=3000
NODE_ENV=development

# Seed & Account Credentials (Student Guide Ep 2.2)
ADMIN_PASSWORD="supersecret_admin_pass"
DEMO_USER_PASSWORD="supersecret_demo_pass"
SEED_DEMO_DATA="true"

# CORS & Client URL (for local split development)
CLIENT_ORIGIN="http://localhost:5173"

# Frontend Vite Configuration
VITE_API_URL="http://localhost:3000"
