# ==============================================================================
# CrustCraft Server - Environment Configuration Example
# ==============================================================================

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://crustcraft:crustcraft_password@localhost:5432/crustcraft?schema=public"

# JWT Secret for Signing and Verifying Tokens
JWT_SECRET="crustcraft-dev-jwt-secret-replace-in-production-2026"

# Server Port & Environment (Cloud Run defaults to PORT=3000 / $PORT)
# PORT=3000
PORT=3000
NODE_ENV=development

# Seed & Account Credentials (Student Guide Ep 2.2)
ADMIN_PASSWORD="supersecret_admin_pass"
DEMO_USER_PASSWORD="supersecret_demo_pass"
SEED_DEMO_DATA="true"

# Allowed Client Origin for CORS (e.g., Vite Dev Server)
CLIENT_ORIGIN="http://localhost:5173"
